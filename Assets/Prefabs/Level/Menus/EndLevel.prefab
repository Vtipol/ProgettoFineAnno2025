  endLevelCanvas: {fileID: 6851130190156899258}
  endText: {fileID: 2190263111754447211}
  returnToMenuButton: {fileID: 5200016489813136393}
  endLines:
  - "<b><size=130%>\u201COde al fanciullo\u201D</size></b>\r\n<i>Lasciatemi</i>\\nnon
    \xE8 successo nulla a nessuno,\\nsono <b>ovunque</b> ma anche da <b>nessuna parte</b>,\\nsuccede
    solo quando <color=#FFD700>gioisco</color>\\nfino all\u2019ultimo profondo strappo.\r\n\r\n<i>lasciatemi
    sulla tua bocca</i>,\\nperch\xE9 s\xEC, perch\xE9 respiro\\nperch\xE9 tocco il
    tuo ginocchio\\ned \xE8 come se arrivassi alla tua <color=#A1EAFB>freschezza</color>.\r\n\r\n<i>con
    o senza tutti.</i>\r\n"
  textSpeed: 0.05
